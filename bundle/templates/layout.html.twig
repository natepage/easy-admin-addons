{% extends '@EasyAdmin/layout.html.twig' %}

{% block body_attr %}{{ parent() }} data-controller="easy-admin-addons-global"{% endblock %}

{% block wrapper_wrapper %}
    {% if adminAddonsContext().crudAddons.isUserImpersonated %}
        {% include adminAddonsContext().templatePath('user_impersonated') %}
    {% endif %}

    {{ parent() }}
{% endblock %}

{% block content_header_wrapper %}
    {{ parent() }}

    {% set contentAlerts = adminAddonsContext().getContentAlerts() %}
    {% if contentAlerts|length > 0 %}
        <section class="alerts-wrapper">
            {% for alert in contentAlerts %}
                <twig:ea:Alert class="{{ loop.last ? 'mb-4' : 'mb-2' }}"
                               variant="{{ alert.variant }}"
                               :icon="alert.icon"
                               :title="alert.title|trans(alert.translationParams, alert.translationDomain)"
                               :withDismissButton="alert.withDismissButton">
                    {{ alert.message|trans(alert.translationParams, alert.translationDomain)|raw }}
                </twig:ea:Alert>
            {% endfor %}
        </section>
    {% endif %}
{% endblock %}
