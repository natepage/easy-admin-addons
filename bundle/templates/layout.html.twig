{% extends '@EasyAdmin/layout.html.twig' %}

{% block content_header_wrapper %}
    {{ parent() }}

    {% if alerts is defined and alerts|length > 0 %}
        <section class="alerts-wrapper mb-4">
            {% for alert in alerts %}
                <twig:ea:Alert variant="{{ alert.variant }}"
                               :icon="alert.icon"
                               :title="alert.title"
                               :withDismissButton="alert.withDismissButton">
                    {{ alert.message|raw }}
                </twig:ea:Alert>
            {% endfor %}
        </section>
    {% endif %}
{% endblock %}
